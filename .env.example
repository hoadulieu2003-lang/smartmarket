NODE_ENV=development
PORT=3000
TZ=Asia/Ho_Chi_Minh

DATABASE_URL=postgresql://postgres:user:password@localhost:5432/smart_market
# Giới hạn pool mỗi tiến trình (chống P2037 "too many clients"). Bỏ trống = dev 5 / prod 10.
# pool_timeout tính bằng giây. Có thể khai thẳng trong DATABASE_URL: ?connection_limit=5&pool_timeout=20
DB_CONNECTION_LIMIT=5
DB_POOL_TIMEOUT=20

JWT_ACCESS_SECRET=change_here
JWT_REFRESH_SECRET=change_here
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=30d

ZALO_APP_ID=
ZALO_APP_SECRET=
# true chỉ dành cho local/dev: cho phép mock token, mock số điện thoại và vị trí browser.
# Server dùng cho Zalo H5 phải đặt false và khai báo đúng APP_ID/APP_SECRET cùng Mini App.
ZALO_MOCK=true

MAX_UPLOAD_MB=5
S3_ENDPOINT=https://s3.example.com
S3_BUCKET=your-bucket
S3_ACCESS_KEY=change_me
S3_SECRET_KEY=change_me
S3_REGION=us-east-1
S3_UPLOAD_PREFIX=uploads
# Bỏ trống nếu public URL có dạng <S3_ENDPOINT>/<S3_BUCKET>/<object-key>
S3_PUBLIC_BASE_URL=https://s3.example.com/your-bucket
S3_FORCE_PATH_STYLE=true

CORS_ORIGINS=*

SEED_SUPER_ADMIN_EMAIL=admin@smartmarket.vn
SEED_SUPER_ADMIN_PASSWORD=change_me
